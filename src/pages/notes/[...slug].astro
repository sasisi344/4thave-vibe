---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
	const allNotes = await getCollection('notes');
	
	// Define target tags for browsing
	const tags = Array.from(new Set(allNotes.flatMap(n => n.data.tags)));

	const postPaths = allNotes.map((note) => ({
		params: { slug: note.id },
		props: { note, type: 'post' as const },
	}));

	const tagPaths = tags.map((tag) => {
		const filteredNotes = allNotes.filter(
			(n) => n.data.tags.some(t => t.toLowerCase() === tag.toLowerCase())
		);
		return {
			params: { slug: `tag/${tag.toLowerCase()}` },
			props: { tag, notes: filteredNotes, type: 'tag' as const },
		};
	});

	return [...postPaths, ...tagPaths];
}

const { type, note, tag, notes } = Astro.props;

const formatDate = (date: Date) => {
	return date.toLocaleDateString('ja-JP', {
		year: 'numeric',
		month: '2-digit',
		day: '2-digit'
	});
};

const Content = type === 'post' ? (await render(note)).Content : null;

const jsonLd = type === 'post' ? JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: note.data.title,
	description: note.data.description ?? '',
	datePublished: note.data.publishDate.toISOString(),
	url: new URL(`/notes/${note.id}/`, Astro.site).href,
	author: { '@type': 'Person', name: '4thave' },
	publisher: { '@type': 'Organization', name: '4thave', url: Astro.site },
}) : null;
---

{type === 'post' ? (
	<Layout title={note.data.title} description={note.data.description}>
		<script slot="head" type="application/ld+json" set:html={jsonLd} />
		<article class="max-w-3xl mx-auto py-20 px-6 animate-fade-in">
			<header class="mb-12">
				<div class="flex items-center gap-4 mb-6">
					<a href={`/notes/${note.data.category.toLowerCase()}`} class="px-4 py-1 rounded-full bg-green-500/20 text-green-400 text-xs font-black uppercase tracking-widest hover:bg-green-500/30 transition-colors">
						{note.data.category}
					</a>
					<span class="text-sm font-bold text-white/30">{formatDate(note.data.publishDate)}</span>
				</div>
				<h1 class="text-4xl md:text-6xl font-black mb-8 leading-tight font-['Outfit'] italic tracking-tighter">
					{note.data.title}
				</h1>
				{note.data.description && (
					<p class="text-xl text-gray-400 italic">
						{note.data.description}
					</p>
				)}
			</header>

			<div class="prose prose-invert prose-lg max-w-none prose-strong:text-white prose-p:text-gray-400 prose-p:leading-relaxed prose-headings:font-['Outfit'] prose-headings:italic">
				<Content />
			</div>

			<footer class="mt-20 pt-12 border-t border-white/5">
				<div class="flex flex-wrap gap-2">
					{note.data.tags.map(tag => (
						<span class="px-4 py-1 rounded-full border border-white/10 text-xs font-bold text-gray-400 uppercase tracking-widest">
							#{tag}
						</span>
					))}
				</div>
				<div class="mt-12">
					<a href="/notes" class="text-sm font-bold text-green-400 hover:text-green-300 transition-colors flex items-center gap-2 underline underline-offset-8">
						<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18" /></svg>
						Back to All Thoughts
					</a>
				</div>
			</footer>
		</article>
	</Layout>
) : (
	<Layout title={`${tag?.toUpperCase()} Archives`} description={`「${tag}」タグに関連するノートのアーカイブ。AI・デザイン・日常の思考断片を集めた4thaveのパーソナルブログ。`}>
		<div class="max-w-4xl mx-auto py-12 px-6">
			<header class="text-center mb-20 animate-fade-in">
				<h1 class="text-4xl md:text-6xl font-black mb-6 font-['Outfit'] italic tracking-tighter uppercase">
					#{tag} <span class="text-gradient">Archives</span>
				</h1>
				<p class="text-gray-400 max-w-2xl mx-auto font-medium">
					Topic: <strong>{tag}</strong> に関連する思考の断片です。
				</p>
			</header>

			<div class="space-y-4">
				{notes?.sort((a,b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()).map((n) => (
					<a href={`/notes/${n.id}`} class="group block glass p-8 rounded-[32px] border border-white/5 hover:border-white/10 transition-all duration-300">
						<div class="flex items-start justify-between gap-6">
							<div class="flex-1">
								<div class="flex items-center gap-4 mb-4">
									<span class="text-xs font-bold text-white/20">{formatDate(n.data.publishDate)}</span>
								</div>
								<h2 class="text-2xl font-bold group-hover:text-green-400 transition-colors leading-snug mb-3 font-['Outfit'] italic">{n.data.title}</h2>
								<p class="text-gray-500 line-clamp-2 leading-relaxed">
									{n.data.description}
								</p>
							</div>
							<div class="shrink-0 w-12 h-12 rounded-2xl border border-white/5 flex items-center justify-center group-hover:bg-green-500 group-hover:border-transparent group-hover:scale-110 transition-all duration-500">
								<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 group-hover:text-black transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
								</svg>
							</div>
						</div>
					</a>
				))}
			</div>
			
			<div class="mt-12 text-center">
				<a href="/notes" class="inline-flex items-center gap-2 text-sm font-bold text-gray-500 hover:text-white transition-colors underline underline-offset-4">
					View All thoughts
				</a>
			</div>
		</div>
	</Layout>
)}

<style>
	.animate-fade-in {
		animation: fadeIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
	}

	@keyframes fadeIn {
		from { opacity: 0; transform: translateY(10px); }
		to { opacity: 1; transform: translateY(0); }
	}
</style>
